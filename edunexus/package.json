{
  "name": "edunexus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import=tsx --test --test-reporter=dot \"tests/**/*.test.ts\"",
    "ci:dry-run": "node scripts/ci-dry-run.mjs",
    "preflight": "node scripts/preflight.mjs",
    "smoke": "node scripts/preflight.mjs && node scripts/smoke.mjs",
    "smoke:testimonials": "node scripts/preflight.mjs && node scripts/smoke-testimonials.mjs",
    "smoke:lecturer": "node scripts/preflight.mjs && node scripts/smoke-lecturer.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.5",
    "jose": "^6.0.0",
    "next": "16.3.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
